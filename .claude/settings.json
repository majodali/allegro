{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__get_job_logs",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__merge_pull_request",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__get_trigger",
      "mcp__Claude_Code_Remote__get_session",
      "Artifact",
      "ReadNotifications",
      "Bash(npm test)",
      "Bash(ALLEGRO_TEST_FILTER=* npm test)",
      "Bash(npm run test:shards)",
      "Bash(MTOOL_HOME=* npm run test:shards)",
      "Bash(npm run lint:docs)",
      "Bash(npm run lint:docs:check)",
      "Bash(npm run lint:ir)",
      "Bash(MTOOL_HOME=* npm run lint:ir)",
      "Bash(npm run lint:streams)",
      "Bash(npm run lint:load)",
      "Bash(npm run lint:units)",
      "Bash(npm run lint:planes)",
      "Bash(npm run lint:lanes)",
      "Bash(bash scripts/typecheck.sh)",
      "Bash(npx tsx scripts/doc-ref-lint.ts)",
      "Bash(npx tsx scripts/doc-lint.ts *)",
      "Bash(npx tsx scripts/stream-plan.ts)",
      "Bash(npx tsx scripts/analyze/index.ts *)",
      "Bash(npx tsx scripts/analyze/lane-lint.ts *)",
      "Bash(PR_TITLE=* npx tsx scripts/analyze/lane-lint.ts *)",
      "Bash(npx tsx src/index.ts *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(mkdir -p *)"
    ]
  }
}
