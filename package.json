{
  "name": "allegro",
  "version": "0.1.0",
  "description": "A programmable language platform where every claim about your code resolves to a visible proof strength — humans and AI agents verify through the same kernel.",
  "private": true,
  "license": "CC0-1.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/majodali/allegro"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "tsx src/test/index.ts",
    "test:shards": "node scripts/test-shards.mjs",
    "bench": "tsx bench/run.ts",
    "check-deployed": "tsx scripts/check-deployed.ts",
    "generate-parser": "tsx grammar/generate-parser.ts",
    "build:web": "esbuild web/allegro-web.ts --bundle --outfile=web/dist/allegro.js --format=iife --global-name=AllegroBundle --platform=browser",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "parser-generator": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0"
  }
}
