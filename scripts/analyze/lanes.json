        "src/boundary-baseline.json",
        "src/evaluator.ts",
        "src/primitives.ts",
        "src/types.ts",
        "src/types-std.ts",
        "scripts/analyze/**",
        "src/test/base.ts",
        "src/test/types-core.ts",
        "src/test/types-construction.ts",
        "src/test/tooling.ts",
        "docs/book/allegretto/**",
        "docs/book/units.md",
        "docs/book/implementation-map.md",
        "docs/plans/host-plane-declaration.md"
      ]
    },
    "P": {
      "name": "performance stream",
      "globs": [
        "src/grammar2/**",
        "bench/**",
        "src/modules.ts",
        "src/use-scanner.ts",
        "src/runtime.ts",
        "src/evaluator.ts",
        "src/totality.ts",
        "src/effects.ts",
        "src/types.ts",
        "src/types-std.ts",
        "src/primitives.ts",
        "src/symbols.ts",
        "src/index.ts",
        "src/test/grammar2-*.ts",
        "src/test/modules.ts",
        "src/test/tooling.ts",
        "src/test/totality.ts",
        "docs/book/extension/**",
        "docs/book/implementation-map.md",
        "docs/book/standard/totality.md",
        "docs/plans/fast-library-load.md",
        "package.json"
      ]
    },
    "S": {
      "name": "the pre-stream arc",
      "globs": [
        "docs/**",
        "scripts/stream-plan.ts",
        "scripts/doc-lint.ts",
        "scripts/analyze/lanes.json",
        "scripts/analyze/lane-lint.ts",
