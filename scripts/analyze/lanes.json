        "src/test/tooling.ts",
        "src/test/pcp.ts",
        "docs/book/platform/**",
        "docs/book/implementation-map.md",
        "deploy.sh",
        "package.json"
      ]
    },
    "D": {
      "name": "L2 semantics",
      "globs": [
        "src/*.ts",
        "src/boundary-baseline.json",
        "lib/**",
        "tests/**",
        "src/test/**",
        "docs/book/**",
        "scripts/analyze/units.json",
        "scripts/analyze/units-baseline.json",
        "scripts/analyze/plane-baseline.json"
      ]
    },
    "K": {
      "name": "kernel hygiene",
      "globs": [
        "src/structure.ts",
        "src/slot-accessors.ts",
        "src/metadata.ts",
        "src/symbols.ts",
